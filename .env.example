# Admin login (placeholders — copy to .env and change)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# JWT signing secret (placeholder — use a long random string in production)
SECRET_KEY=replace-with-a-long-random-secret-key

# Optional
# DATABASE_URL=sqlite:///./data/store.db
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# WeChat mini program (placeholders only — never commit real AppID/Secret)
WX_APPID=wxXXXXXXXXXXXXXXXX
WX_SECRET=replace-with-wechat-app-secret
# 1 = local DevTools mock (any code → deterministic openid); 0 = real jscode2session
WX_MOCK_OPENID=1
