.detail {
  padding-bottom: 0;
}

.detail__gallery {
  height: 560rpx;
  background: #FFFFFF;
}

.detail__img {
  width: 100%;
  height: 560rpx;
  background: #F0F0ED;
}

.detail__panel {
  margin: 0 0 8rpx;
  padding: 32rpx;
  background: #FFFFFF;
  border-bottom: 2rpx solid #E5E5E0;
}

.detail__badges {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.detail__name {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A18;
  line-height: 1.35;
}

.detail__sku {
  margin-top: 12rpx;
  font-size: 24rpx;
}

.detail__price-row {
  margin-top: 20rpx;
}

.detail__stock {
  margin-top: 16rpx;
  font-size: 24rpx;
}

.detail__stock--success { color: #16A34A; }
.detail__stock--warning { color: #D97706; }
.detail__stock--danger { color: #DC2626; }

.detail__section {
  margin-top: 8rpx;
  padding: 32rpx;
  background: #FFFFFF;
  border-bottom: 2rpx solid #E5E5E0;
}

.detail__section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: #1A1A18;
}

.detail__spec-label {
  font-size: 24rpx;
  color: #6B6B63;
  margin-bottom: 12rpx;
}

.detail__specs {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.detail__pill {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  border: 2rpx solid #E5E5E0;
  background: #F7F7F5;
  font-size: 24rpx;
  color: #1A1A18;
}

.detail__pill.is-active {
  border-color: #0F766E;
  background: #CCFBF1;
  color: #134E4A;
  font-weight: 600;
}

.detail__pill.is-disabled {
  opacity: 0.4;
  text-decoration: line-through;
}

.detail__highlights {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.detail__chip {
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
  background: #F0F0ED;
  color: #6B6B63;
}

.detail__desc {
  font-size: 28rpx;
  color: #6B6B63;
  white-space: pre-wrap;
  line-height: 1.6;
}

.detail__related {
  white-space: nowrap;
}

.detail__related-item {
  display: inline-block;
  width: 280rpx;
  margin-right: 20rpx;
  vertical-align: top;
}

.detail__spacer {
  height: 160rpx;
}

.detail__bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border-top: 2rpx solid #E5E5E0;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.detail__fav {
  flex: 0 0 180rpx;
}

.detail__cta {
  flex: 1;
}
