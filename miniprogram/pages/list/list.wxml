<view class="list cx-page">
  <view class="list__search">
    <view class="list__search-box">
      <text class="list__search-icon">⌕</text>
      <input
        class="list__search-input"
        placeholder="搜索商品 / SKU"
        placeholder-class="list__ph"
        value="{{keyword}}"
        confirm-type="search"
        bindinput="onKeyword"
        bindconfirm="onSearch"
      />
      <text class="list__clear" wx:if="{{keyword}}" bindtap="onClear">清除</text>
    </view>
  </view>

  <view class="list__filters">
    <filter-chips items="{{categories}}" active-id="{{activeCategory}}" bind:change="onCategory" />
  </view>

  <view class="list__toolbar">
    <text class="list__count">共 {{products.length}} 件</text>
    <view class="list__sorts">
      <text
        wx:for="{{sortOptions}}"
        wx:key="id"
        class="list__sort {{sort === item.id ? 'is-active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onSort"
      >{{item.label}}</text>
    </view>
  </view>

  <view class="list__grid" wx:if="{{products.length}}">
    <view class="list__cell" wx:for="{{products}}" wx:key="id">
      <product-card
        product-id="{{item.id}}"
        name="{{item.name}}"
        cover="{{item.cover}}"
        price="{{item.price}}"
        compare-at-price="{{item.compareAtPrice}}"
        badge="{{item.badges[0]}}"
        stock="{{item.stock}}"
        category="{{item.category}}"
        sku="{{item.sku}}"
        bind:open="onOpenProduct"
      />
    </view>
  </view>

  <view class="cx-empty" wx:else>
    <view class="cx-empty__title">没有找到相关商品</view>
    <view class="cx-empty__desc">换个关键词或分类试试</view>
  </view>

  <view class="list__foot cx-safe-bottom">精选日常 · 澄净所见</view>
</view>
