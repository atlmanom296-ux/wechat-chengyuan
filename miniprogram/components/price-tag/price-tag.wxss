.price {
  display: inline-flex;
  align-items: baseline;
  color: #C2410C;
  font-weight: 700;
  gap: 4rpx;
}

.price__currency {
  font-size: 0.7em;
}

.price__compare {
  margin-left: 12rpx;
  font-size: 0.65em;
  font-weight: 400;
  color: #9A9A90;
  text-decoration: line-through;
}

.price__suffix {
  margin-left: 6rpx;
  font-size: 0.6em;
  font-weight: 500;
  color: #6B6B63;
}

.price--sm { font-size: 28rpx; }
.price--md { font-size: 36rpx; }
.price--lg { font-size: 48rpx; }
