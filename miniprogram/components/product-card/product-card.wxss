.card {
  background: #FFFFFF;
  border-radius: 28rpx;
  overflow: hidden;
  border: 2rpx solid #E5E5E0;
  display: flex;
  flex-direction: column;
}

.card__media {
  position: relative;
  width: 100%;
  padding-top: 100%;
  background: #F0F0ED;
}

.card__img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.card__badge {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
}

.card__soldout {
  position: absolute;
  inset: 0;
  background: rgba(26, 26, 24, 0.45);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.card__body {
  padding: 20rpx 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.card__name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1A1A18;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card__meta {
  font-size: 22rpx;
  color: #9A9A90;
}

.card__row {
  margin-top: 4rpx;
}

.is-soldout .card__name {
  color: #6B6B63;
}
