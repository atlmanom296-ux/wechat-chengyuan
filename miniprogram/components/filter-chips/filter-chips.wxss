.chips {
  white-space: nowrap;
  width: 100%;
}

.chips__item {
  display: inline-flex;
  align-items: center;
  height: 60rpx;
  padding: 0 28rpx;
  margin-right: 16rpx;
  border-radius: 9999rpx;
  background: #FFFFFF;
  border: 2rpx solid #E5E5E0;
  color: #6B6B63;
  font-size: 26rpx;
  font-weight: 500;
}

.chips__item.is-active {
  background: #CCFBF1;
  border-color: #0F766E;
  color: #134E4A;
}
