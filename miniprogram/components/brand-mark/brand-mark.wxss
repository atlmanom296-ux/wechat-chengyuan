.brand {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.brand__mark {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: #0F766E;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.brand__bar {
  width: 12rpx;
  height: 40rpx;
  border-radius: 4rpx;
  background: #CCFBF1;
}

.brand__bar--short {
  width: 20rpx;
  height: 12rpx;
  background: #F0FDFA;
  align-self: flex-end;
  margin-bottom: 14rpx;
}

.brand__text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.brand__name {
  font-size: 36rpx;
  font-weight: 600;
  color: #1A1A18;
  line-height: 1.2;
}

.brand__tagline {
  font-size: 22rpx;
  color: #6B6B63;
  line-height: 1.3;
}

.brand--lg .brand__mark {
  width: 112rpx;
  height: 112rpx;
  border-radius: 28rpx;
}

.brand--lg .brand__bar {
  width: 16rpx;
  height: 56rpx;
}

.brand--lg .brand__bar--short {
  width: 28rpx;
  height: 16rpx;
  margin-bottom: 20rpx;
}

.brand--lg .brand__name {
  font-size: 48rpx;
}

.brand--lg .brand__tagline {
  font-size: 26rpx;
}

.brand--sm .brand__mark {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
}

.brand--sm .brand__name {
  font-size: 28rpx;
}
