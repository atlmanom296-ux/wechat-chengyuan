.form {
  padding: 24rpx 24rpx 64rpx;
}

.form__section {
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.form__section--row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.form__section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
  color: var(--color-text);
}

.form__switch-hint {
  display: block;
  font-size: 22rpx;
  margin-top: -8rpx;
}

.form__picker {
  line-height: 1.4;
}

.form__preview {
  width: 100%;
  height: 280rpx;
  border-radius: var(--radius-md);
  background: var(--color-surface-muted);
  margin-top: 8rpx;
}

.form__error {
  display: block;
  margin: 8rpx 8rpx 16rpx;
}

.form__actions {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.form__actions .cx-btn {
  flex: 1;
}
